[Unit]
Description=Master of Orion — Reborn — daily health check
Documentation=file:/opt/moogenesis/scripts/doctor.sh
# doctor.sh probes the live site and DNS: wait for the network and for whichever
# web server fronts the game (units that are not installed are simply ignored).
Wants=network-online.target
After=network-online.target nginx.service caddy.service

[Service]
Type=oneshot
# Exit 2 (something is broken) marks the unit failed — visible in
# `systemctl --failed` and the journal. Exit 1 (warnings only) is accepted.
SuccessExitStatus=1
ExecStart=/bin/bash /opt/moogenesis/scripts/doctor.sh --root /opt/moogenesis --quiet
