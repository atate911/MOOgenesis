# Caddy site for Master of Orion — Reborn (static files + the save server / password gate snippet).
# install.sh renders this into /etc/caddy/conf.d/moogenesis.caddy, which the main
# Caddyfile pulls in with:  import /etc/caddy/conf.d/*.caddy
# Caddy obtains and renews the TLS certificate for this name by itself.

@DOMAIN@ {
    root * @ROOT@/current
    encode zstd gzip

    # Password gate + /api/ (server saves). The scripts own this file and rewrite it on every run.
    import /etc/caddy/moogenesis-saves.caddyfile

    # Never serve dotfiles (.treehash etc.).
    @dotfiles path_regexp dot ^/\.
    handle @dotfiles {
        respond 404
    }

    # version.txt is how install/upgrade/doctor verify WHICH release is live.
    handle /version.txt {
        header {
            Cache-Control "no-store"
            X-Content-Type-Options "nosniff"
            Referrer-Policy "strict-origin-when-cross-origin"
            X-Frame-Options "SAMEORIGIN"
        }
        file_server
    }

    # Caching. Each release stamps a build id into js/manifest.js, and
    # js/loader.js appends ?v=<build id> to every css/js URL it loads. Only such
    # fingerprinted URLs are cached for long: a new release means new URLs.
    @fingerprinted {
        path /js/* /css/* /assets/*
        not path /js/manifest.js /js/loader.js
        query v=*
    }
    handle @fingerprinted {
        header {
            Cache-Control "public, max-age=31536000, immutable"
            X-Content-Type-Options "nosniff"
            Referrer-Policy "strict-origin-when-cross-origin"
            X-Frame-Options "SAMEORIGIN"
        }
        file_server
    }

    # Everything else (index.html, js/manifest.js, js/loader.js, un-fingerprinted
    # assets) is revalidated on every load (no-cache + ETag → 304).
    handle {
        header {
            Cache-Control "no-cache"
            X-Content-Type-Options "nosniff"
            Referrer-Policy "strict-origin-when-cross-origin"
            X-Frame-Options "SAMEORIGIN"
        }
        file_server
    }
}
