# nginx site for Master of Orion — Reborn (static files + the save server / password gate snippet).
# install.sh renders this once into /etc/nginx/sites-available/moogenesis.conf.
# certbot --nginx later adds the 443 server block and the http->https redirect
# to the INSTALLED copy; upgrade.sh never rewrites it.

# Caching. Each release stamps a build id into js/manifest.js, and js/loader.js
# appends ?v=<build id> to every css/js URL it loads. Only such fingerprinted
# URLs may be cached for a long time: a new release means new URLs, so nothing
# stale can be reused. Everything else — index.html, js/manifest.js,
# js/loader.js, version.txt and un-fingerprinted assets (world art) — must be
# revalidated on every load (no-cache + ETag → 304). `map` must sit outside
# the server block (sites-enabled files are included from the http context).
map "$uri?$arg_v" $moo_cache_control {
    default                              "no-cache";
    "~^/js/(manifest|loader)\.js\?"      "no-cache";
    "~^/(js|css|assets)/.+\?.+$"         "public, max-age=31536000, immutable";
}

server {
    listen 80;
    listen [::]:80;
    server_name @DOMAIN@;

    root @ROOT@/current;
    index index.html;

    # Password gate + /api/ (server saves). The scripts own this file and rewrite it on every run.
    include /etc/nginx/snippets/moogenesis-saves.conf;

    # NOTE: add_header at location level REPLACES the server-level set, so every
    # location below that sets a header repeats all four.
    add_header Cache-Control $moo_cache_control always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript text/javascript application/json image/svg+xml;

    # version.txt is how install/upgrade/doctor verify WHICH release is live.
    location = /version.txt {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        default_type text/plain;
    }

    # Never serve dotfiles (.git, .treehash; .well-known excepted for certificate renewal).
    location ~ /\.(?!well-known) {
        deny all;
        return 404;
    }

    # The install manifest: older mime.types files have no entry for .webmanifest.
    location = /manifest.webmanifest {
        types { }
        default_type application/manifest+json;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # World art is .webp; nginx <= 1.18 (Ubuntu 22.04) has no image/webp in mime.types.
    location ~* \.webp$ {
        types { }
        default_type image/webp;
        add_header Cache-Control $moo_cache_control always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    access_log /var/log/nginx/moogenesis.access.log;
    error_log  /var/log/nginx/moogenesis.error.log;
}
